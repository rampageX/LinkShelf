<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>../../Source/app.manifest</ApplicationManifest>
    <ApplicationIcon>../../Source/Assets/LinkShelf.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>LinkShelfMover</AssemblyName>
    <Version>1.0.6</Version>
    <FileVersion>1.0.6.0</FileVersion>
    <AssemblyVersion>1.0.6.0</AssemblyVersion>
    <InformationalVersion>1.0.6</InformationalVersion>
    <AssemblyTitle>LinkShelf Mover - 文件夹迁移并建立连接点</AssemblyTitle>
    <Product>LinkShelf Mover</Product>
    <Description>安全迁移目录并在原位置创建 NTFS 目录连接点或符号链接</Description>
    <Company>Punk</Company>
    <Copyright>Copyright © 2026 Punk</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Source/UI/Dark.cs" Link="Shared/Dark.cs" />
    <Compile Include="../../Source/UI/DarkComboBox.cs" Link="Shared/DarkComboBox.cs" />
    <Compile Include="../../Source/Core/Models.cs" Link="Shared/Models.cs" />
    <Compile Include="../../Source/Core/Reparse.cs" Link="Shared/Reparse.cs" />
    <Compile Include="../../Source/Core/Language.cs" Link="Shared/Language.cs" />
    <EmbeddedResource Include="../../languages.json" LogicalName="LinkShelf.languages.json" />
    <Content Include="../../languages.json" Link="languages.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
